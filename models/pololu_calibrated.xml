<mujoco model="pololu_calibrated">
  <!--
    MuJoCo model of the Pololu 3pi+ 2040 robot, used as the hidden plant of the
    MuJoCo deployment studies (only wmr_simulator.mujoco_sim reads it).

    models/pololu_hidden.yaml overrides the motor, wheel geometry, frictions,
    encoder, IMU and mocap values below at load time; masses, chassis geometry
    and contact softness are defined here only.

    Geometry from Pololu's drawing and STEP assembly of item 3725: body
    diameter 97.0 mm, wheel diameter 32.0 mm, caster ball 12.7 mm (centre
    40.37 mm behind the axle), ground clearance 5.0 mm. Measured on the robot:
    total mass 171 g, CoM 2-3 mm behind the drive axle, wheel track 84.2 mm.
    At rest the robot sits on the caster, slightly nose up.
  -->
  <compiler angle="radian" inertiafromgeom="true"/>

  <option timestep="0.001" integrator="implicit" gravity="0 0 -9.81"/>

  <visual>
    <global azimuth="45" elevation="-30" offwidth="1920" offheight="1080"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" reflectance="0"/>
    <texture name="wheel_tex" type="2d" builtin="checker"
            rgb1="0.05 0.05 0.05" rgb2="0.9 0.9 0.9"
            width="256" height="256"/>
    <material name="wheel_mat" texture="wheel_tex"
              texrepeat="6 1" texuniform="true" reflectance="0.0"/>
    <!--
      Pololu's STEP assembly, tessellated. Visual only: the collision set is
      four analytic primitives.
    -->
    <mesh name="chassis_mesh" file="pololu_chassis.stl"/>
    <mesh name="wheel_mesh" file="pololu_wheel.stl"/>
  </asset>

  <worldbody>
    <!--
      Near-rigid floor (sets the effective rolling radius through the contact
      penetration). The wheel geoms carry the same solref/solimp, since MuJoCo
      mixes the two geoms' values. The time constant cannot go below twice the
      0.001 s timestep.
    -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          friction="0.9 0.005 0.0001"
          solref="0.003 2" solimp="0.99 0.9999 0.0005"/>

    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!--
      Body frame: origin at the wheel-axle midpoint, +x forward, +z up. The
      floor is at z = -0.016 (the wheel radius).
    -->
    <body name="chassis" pos="0 0 0.0163">
      <freejoint name="root"/>
      <camera name="track_cam" mode="track" pos="0 -0.6 0.25" xyaxes="1 0 0 0 0.6 1"/>

      <!--
        Mass budget (total 171 g, CoM 2.5 mm behind the axle, 15 mm above the floor):
          chassis_deck    74.24 g   tub + skirt + motors + clips
          control_board   32.0  g
          battery_pack    52.0  g   4x AAA NiMH
          wheels        2x 5.63 g   from the default density
          caster ball      1.5  g   12.7 mm POM sphere
      -->
      <geom name="chassis_visual" type="mesh" mesh="chassis_mesh"
            contype="0" conaffinity="0" mass="0"
            rgba="0.93 0.93 0.93 1.0"/>

      <geom name="chassis_deck" type="cylinder"
            size="0.0485 0.0077" pos="0 0 -0.0033"
            contype="0" conaffinity="0"
            rgba="0.93 0.93 0.93 0.0" mass="0.0783"/>

      <geom name="control_board" type="cylinder"
            size="0.045 0.001" pos="0 0 0.006"
            contype="0" conaffinity="0"
            rgba="0.10 0.35 0.20 0.0" mass="0.032"/>

      <geom name="battery_pack" type="box"
            size="0.0225 0.020 0.0055" pos="-0.0070566 0 -0.00174"
            contype="0" conaffinity="0"
            rgba="0.2 0.2 0.2 0.0" mass="0.052"/>

      <!--
        32 x 7 mm wheels; their mass follows from MuJoCo's default density.
      -->
      <body name="left_wheel" pos="0.0 0.0421 0.0">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"
               damping="0.0" armature="3.5205e-6" frictionloss="2e-6"/>
        <geom name="left_wheel_visual" type="mesh" mesh="wheel_mesh"
              contype="0" conaffinity="0" mass="0"
              rgba="0.15 0.15 0.15 1"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.016 0.0019"
              rgba="1 1 1 0" euler="1.5708 0 0"
              material="wheel_mat" mass="0.0036"
              friction="0.9 0.001 0.0001"
              solref="0.003 2" solimp="0.99 0.9999 0.0005"/>
      </body>

      <body name="right_wheel" pos="0.0 -0.0421 0.0">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"
               damping="0.0" armature="3.5205e-6" frictionloss="2e-6"/>
        <geom name="right_wheel_visual" type="mesh" mesh="wheel_mesh"
              contype="0" conaffinity="0" mass="0"
              rgba="0.15 0.15 0.15 1"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.016 0.0019"
              rgba="1 1 1 0" euler="1.5708 0 0"
              material="wheel_mat" mass="0.0036"
              friction="0.9 0.001 0.0001"
              solref="0.003 2" solimp="0.99 0.9999 0.0005"/>
      </body>

      <!--
        Rolling ball caster on a ball joint; frictionloss is the socket drag.
      -->
      <body name="caster" pos="-0.04037 0.0 -0.00940">
        <joint name="caster_ball" type="ball" frictionloss="2e-7" damping="0"/>
        <geom name="caster_geom" type="sphere" size="0.00635"
              rgba="0.5 0.5 0.5 1"
              friction="0.35 0.001 0.0001"
              mass="0.0015"/>
        <!--
          Visual marker on the caster ball (no contact, no mass), so its
          rotation is visible.
        -->
        <geom name="caster_marker" type="sphere" size="0.0017" pos="0 0 -0.0052"
              rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0" mass="0"/>
      </body>

      <!--
        Nose skid: the front lip of the skirt, a 3 mm sphere at the 5.0 mm
        ground clearance. Massless (included in chassis_deck).
      -->
      <geom name="nose_skid" type="sphere" size="0.003"
            pos="0.0455 0 -0.008"
            rgba="0.93 0.93 0.93 1.0"
            friction="0.35 0.001 0.0001"
            mass="0"/>

    </body>
  </worldbody>

  <!--
    Explicit contact pairs, so the caster and the nose skid keep their own
    friction (MuJoCo otherwise takes the elementwise maximum with the floor's).
    solref="-k -c" gives stiffness [N/m] and damping [N-s/m]: the caster carries
    static load and is soft and well damped; the nose is a rigid lip that stops
    the dive under braking. The caster's rolling friction terms are small so
    the ball rolls.
  -->
  <contact>
    <pair name="floor_caster" geom1="floor" geom2="caster_geom"
          friction="0.35 0.35 0.001 0.0001 0.0001"
          solref="-5000 -40"/>
    <pair name="floor_nose" geom1="floor" geom2="nose_skid"
          friction="0.35 0.35 0.001 0.0001 0.0001"
          solref="-10000 -60"/>
  </contact>

  <actuator>
    <!-- kv = T_stall/omega_max = 0.0368/230 = 1.6000e-4; ctrlrange = +-1.2*omega_max -->
    <velocity name="left_motor"  joint="left_wheel_joint"  kv="1.6e-4" ctrlrange="-276 276"/>
    <velocity name="right_motor" joint="right_wheel_joint" kv="1.6e-4" ctrlrange="-276 276"/>
  </actuator>

</mujoco>
